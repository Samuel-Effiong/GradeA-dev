rately generous\n    # multiple of the measured number, not a tightened new floor - lower it\n    # once a real run here confirms the actual CI time, the same way the\n    # old 60-minute cap should have been revisited once --parallel landed\n    # instead of left at "the suite plus margin" indefinitely.\n    #\n    # First real run (2026-09-28, beta be78221, run 36444904862): test step\n    # 633s, whole job 12m55s. The whole-repo mypy step added after the suite\n    # costs ~2 min cold, so 20 left too little margin; 30 until the test-speed\n    # work brings the job down.\n    #\n    # 2026-10-17: the suite grew to 8060 tests (test step 26.6 min) and run\n    # 39022068364 on e65d1ae6 was cut off at 30 min inside mypy, with every\n    # test passing. 45 gives the job room until the test-speed work lands.\n    timeout-minutes: 45\n\n    services:\n      postgres:\n        image: postgres:16\n        env:\n          POSTGRES_USER: postgres\n          POSTGRES_PASSWORD: postgres  # pragma: allowlist secret\n          POSTGRES_DB: gradeaplus_ci\n        ports:\n          - 5432:5432\n        # Without this the job races the container and fails on connect.\n        options: >-\n          --health-cmd pg_isready\n          --health-interval 10s\n          --health-timeout 5s\n          --health-retries 5\n\n      redis:\n        image: redis:7\n        ports:\n          - 6379:6379\n        options: >-\n          --health-cmd "redis-cli ping"\n          --health-interval 10s\n          --health-timeout 5s\n          --health-retries 5\n\n    env:\n      # settings.py reads ENVIRONMENT to choose which DB/Redis/Stripe keys\n      # to look up; "local" is the branch that points at the *_LOCAL vars\n      # wired to the service containers above.\n      ENVIRONMENT: local\n      SECRET_KEY: ci-secret-key-not-used-outside-ci  # pragma: allowlist secret\n      FRONTEND_DOMAIN: http://localhost:3000\n      # Deliberately distinct from FRONTEND_DOMAIN - students and teachers\n      # use separate frontend apps, and this keeps CI actually exercising\n      # that separation instead of only ever hitting the fallback branch.\n      STUDENT_FRONTEND_DOMAIN: http://localhost:3001\n      DATABASE_URI_LOCAL: postgres://postgres:postgres@localhost:5432/gradeaplus_ci  # pragma: allowlist secret\n      REDIS_LOCAL_URL: redis://localhost:6379/0\n      # Every value below is required at import time by settings.py. They\n      # are deliberately fake: the suite mocks all outbound calls, and a CI\n      # run must never be able to reach a real Stripe, Cloudinary, or\n      # mail provider.\n      LOCAL_STRIPE_PUBLIC_KEY: pk_test_ci\n      LOCAL_STRIPE_SECRET_KEY: sk_test_ci  # pragma: allowlist secret\n      LOCAL_STRIPE_WEBHOOK_SECRET: whsec_ci  # pragma: allowlist secret\n      CLOUDINARY_CLOUD_NAME: ci\n      CLOUDINARY_API_KEY: ci  # pragma: allowlist secret\n      CLOUDINARY_API_SECRET: ci  # pragma: allowlist secret\n      MAILSEND_API_KEY: ci  # pragma: allowlist secret\n      GOOGLE_OAUTH_CLIENT_ID: ci\n      GOOGLE_OAUTH_CLIENT_SECRET: ci  # pragma: allowlist secret\n      GOOGLE_REDIRECT_URI: http://localhost:3000/auth/google\n      # ai_processor/services.py reads this at module import with no default,\n      # and users.views -> ... -> ai_processor.services is on the URLconf\n      # import chain, so without it Django cannot even load urls.py.\n      OPENROUTER_API_KEY: sk-or-ci-not-a-real-key  # pragma: allowlist secret\n      # Fernet key for encrypted_model_fields: must base64-decode to EXACTLY\n      # 32 bytes or users/models.py fails at import and every step dies\n      # before it runs. This one decodes to b"ci-test-key-not-for-production!!".\n      FIELD_ENCRYPTION_KEY: Y2ktdGVzdC1rZXktbm90LWZvci1wcm9kdWN0aW9uISE=  # pragma: allowlist secret\n\n    steps:\n      - uses: actions/checkout@v4\n\n      - uses: actions/setup-python@v5\n        with:\n          python-version: "3.12"\n          cache: pip\n\n      - name: Install system dependencies\n        # Mirrors the Dockerfile: OCR and PDF handling need these present\n        # before the Python packages that bind to them will import.\n        run: |\n          sudo apt-get update\n          sudo apt-get install -y --no-install-recommends \\\n            tesseract-ocr poppler-utils libgl1 libglib2.0-0\n\n      - name: Install Python dependencies\n        run: |\n          python -m pip install --upgrade pip\n          pip install -r requirements.txt\n\n      - name: Check for missing migrations\n        # Catches a model change committed without its migration, which\n        # otherwise surfaces as a confusing failure on deploy.\n        run: python manage.py makemigrations --check --dry-run\n\n      - name: Run tests\n        # --parallel 4, not "auto": auto picks this runner\'s CPU count,\n        # which this suite has not been measured against and may not match\n        # the box these numbers came from. 4 is deliberately conservative -\n        # measured locally at 33 peak Postgres connections (of 100), wide\n        # margin even with the suite\'s several "twenty simultaneous\n        # connections" stress tests, and a 7.85x wall-clock speedup on its\n        # own (see the timeout comment below for the actual numbers this\n        # is based on).\n        run: coverage run manage.py test --noinput --parallel 4\n\n      - name: Combine coverage from parallel workers\n        # `--parallel` runs tests in forked worker processes, each writing\n        # its OWN `.coverage.*` data file (`.coveragerc`\'s\n        # `concurrency = multiprocessing` is what makes that happen at\n        # all) - `coverage report` below reads ONE combined file, not many\n        # partial ones. Skipping this step would make the coverage\n        # percentage silently collapse to whatever the tiny dispatcher\n        # process itself executed, not what the suite actually covers.\n        run: coverage combine\n\n      - name: Coverage report\n        # Reported for visibility only - deliberately NOT failing the build\n        # on a coverage threshold. A percentage gate pressures people into\n        # writing assertion-free tests that raise the number without\n        # catching anything.\n        run: coverage report -m\n\n      - name: Type check (mypy)\n        # The pre-commit mypy hook, run here rather than in pre-commit.yml\n        # because it needs this job\'s installed requirements and settings\n        # env (see the SKIP there). Running the hook itself keeps one\n        # definition of mypy\'s args. !cancelled() keeps it independent of\n        # the test result, as it was when it lived in the other workflow.\n        if: ${{ !cancelled() }}\n        run: pre-commit run mypy --all-files\n' : tests.yml must install requirements-dev.txt

