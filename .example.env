# NOTE ON BLANK VALUES
# ---------------------
# A key left blank here is read as the empty string, NOT as "unset". For any
# setting parsed with env.int()/env.float()/env.bool() in
# AutoGrader/settings.py that raises at import time, so copying this file
# verbatim used to stop the app booting with e.g.
#   ValueError: invalid literal for int() with base 10: ''
# Numeric and boolean keys therefore carry their real default here. Blank is
# still fine for string settings, where "" is a legitimate value.

# Copy to .env and fill in. settings.py calls env.read_env(".env") with a
# hardcoded filename, so the file must be named .env (or the values must be
# exported into the environment another way - see QA_SERVER_SETUP.md).
#
# Anything under "Required" has NO default in settings.py: leave it blank
# and the process fails at import, before it can serve a request.

# ---------------------------------------------------------------- Required
# Chooses which of the environment-specific values below are read.
# One of: local | dev | prod
ENVIRONMENT=local

SECRET_KEY=
FRONTEND_DOMAIN=http://localhost:3000
# Student-facing frontend app. Optional - falls back to FRONTEND_DOMAIN
# (the teacher app) when unset.
STUDENT_FRONTEND_DOMAIN=

# Database - only the one matching ENVIRONMENT is read.
#   local -> DATABASE_URI_LOCAL, dev -> DATABASE_URI_DEV, prod -> DATABASE_URI
DATABASE_URI_LOCAL=postgres://user:password@localhost:5432/gradeaplus  # pragma: allowlist secret
DATABASE_URI_DEV=
DATABASE_URI=

# Redis, for both cache and the Celery broker/result backend.
# Same per-environment split as the database.
REDIS_LOCAL_URL=redis://localhost:6379/0
REDIS_DEV_URL=
REDIS_PROD_URL=

# Stripe. `local` and `dev` read the LOCAL_* keys and MUST use test-mode
# (sk_test_/pk_test_) credentials; only prod reads the unprefixed ones.
LOCAL_STRIPE_PUBLIC_KEY=pk_test_
LOCAL_STRIPE_SECRET_KEY=sk_test_  # pragma: allowlist secret
LOCAL_STRIPE_WEBHOOK_SECRET=whsec_  # pragma: allowlist secret
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Media storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email (MailerSend).
MAILSEND_API_KEY=

# Google OAuth. The redirect URI must exactly match the one registered in
# the Google console, or sign-in fails at the callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google

# AI grading provider.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------- Optional
# Has a default in settings.py; override only when you mean to.

# Field-level encryption. Blank disables it - set a real key before storing
# anything sensitive in production.
FIELD_ENCRYPTION_KEY=

# Error reporting. Blank disables Sentry; it is only initialised when this
# is set AND ENVIRONMENT is dev or prod.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Marketing list sync.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID_TEACHER=
MAILERLITE_GROUP_ID_STUDENT=
MAILERLITE_GROUP_ID_SCHOOL_ADMIN=

# Grading pipeline tuning.
GRADING_LOG_LEVEL=INFO
GRADING_ANSWER_CACHE_ENABLED=True
GRADING_EVIDENCE_ENFORCEMENT=
GRADING_MAX_IMAGES_PER_CALL=5
GRADING_BENCHMARK_DAY_OF_WEEK=0
# Model used for the targeted re-read of claimed-blank answers. Blank uses
# default routing (a narrower question than full extraction).
ANSWER_BLANK_VERIFICATION_MODEL=
# Rendered-PDF cache for assignment downloads (assignments/pdf_cache.py).
ASSIGNMENT_PDF_CACHE_ENABLED=True
# These are numeric settings, so leave the value in place rather than
# blanking it - an empty string is not a valid int/float and env.int()
# raises at startup rather than falling back to its default.
#
# How long a cached PDF lives (seconds). The cache key contains the
# assignment's updated_at, so an edit can never be served from a stale
# entry however long this is.
ASSIGNMENT_PDF_CACHE_TTL_SECONDS=86400
# Renders larger than this (bytes) are served but never cached, so a few
# image-heavy assignments cannot evict everything else. 0 disables the cap.
ASSIGNMENT_PDF_CACHE_MAX_BYTES=5242880
# How long a caller waits on someone else's in-progress render of the same
# PDF before rendering for itself (seconds). Must stay above a normal
# render or waiters re-render exactly what they were waiting for.
ASSIGNMENT_PDF_SINGLEFLIGHT_TIMEOUT_SECONDS=60.0

# Headless-Chromium PDF renderer (assignments/pdf_renderer.py).
# Renders one warm browser handles before being recycled; 0 disables
# recycling.
PDF_RENDERER_MAX_RENDERS_PER_BROWSER=500
# Pages rendered at once per worker process - this is what bounds peak
# memory (~20 MB per open page on top of Chromium's ~165 MB).
PDF_RENDERER_MAX_CONCURRENT_RENDERS=4
# Load shedding: renders queued or running per worker before further ones
# are refused with 503 + Retry-After instead of queueing. Unset entirely
# to derive 4x the concurrency above; 0 disables shedding.
PDF_RENDERER_MAX_QUEUED_RENDERS=16

# Benchmark run archive. Every paid benchmark run uploads its full raw
# output (every model response) so a question nobody has thought of yet can
# still be answered about an old run — which is how the LaTeX evidence bug
# was found. It reuses the CLOUDINARY_* credentials above, so there is
# nothing extra to configure. Roughly 1 MB per run.
#
# Automatically forced off while tests run. Set False to disable entirely;
# the run history files and database mirror are unaffected either way.
# Left COMMENTED OUT, not blank: its default is computed (off while tests
# run) and an empty value is not a valid bool, so uncommenting requires
# choosing True or False deliberately.
# BENCHMARK_ARCHIVE_ENABLED=True
# RawMediaCloudinaryStorage is correct for a .json.gz — the default
# MediaCloudinaryStorage is image-typed and mishandles it.
BENCHMARK_ARCHIVE_STORAGE=
BENCHMARK_ARCHIVE_PREFIX=benchmark_archives

# Scheduled-job times (UTC).
WEEKLY_COURSE_SUMMARY_HOUR=7
WEEKLY_COURSE_SUMMARY_MINUTE=0
AT_RISK_ALERT_HOUR=6
AT_RISK_ALERT_MINUTE=30
TEACHER_INACTIVITY_ALERT_HOUR=6
TEACHER_INACTIVITY_ALERT_MINUTE=45

# QA-only switches. Keep these false in production: they expose
# time-travel and live-QA endpoints intended for testing.
ENABLE_STRIPE_LIVE_QA=False
ENABLE_BILLING_TIME_TRAVEL=False
ENABLE_AI_LIVE_QA=False
USE_BETA_PLAN_ON_SIGNUP=False

# Prod only. Off by default - only enable once the proxy is confirmed to
# set X-Forwarded-Proto, or every request redirect-loops.
SECURE_SSL_REDIRECT=False

# Personal vs business email rules. Individual (teacher) accounts require a
# personal mailbox; school admin and license-enrolled teacher accounts
# require a business one. The built-in consumer and disposable provider
# lists live in users/utils.py - these settings only ADD to them, so leave
# them blank unless a specific domain needs classifying.
#
# Comma-separated domain lists. Subdomains of a listed domain match too.
DISALLOWED_EMAIL_DOMAINS=
DISPOSABLE_EMAIL_DOMAINS=

# Strict mode: when set, ONLY these domains count as business emails, so
# school admin and license enrollment are limited to known schools. Blank
# means "anything that isn't a consumer or disposable provider".
ALLOWED_BUSINESS_EMAIL_DOMAINS=

# QA lever. Domains listed here skip the personal/business check ENTIRELY -
# they can create both individual and school accounts. Leave BLANK in
# production; a public throwaway domain here is an open door to school admin
# accounts. Example for a QA environment: EXEMPT_EMAIL_DOMAINS=yopmail.com
EXEMPT_EMAIL_DOMAINS=
